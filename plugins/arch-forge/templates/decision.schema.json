{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/keneanderson/claude-arch-forge/templates/decision.schema.json",
  "title": "arch-forge decision",
  "description": "The architecture confirmed by the user. Saved to docs/architecture/decision.json and used as the input of the scaffold workflow.",
  "type": "object",
  "required": [
    "version",
    "project",
    "topology",
    "repoLayout",
    "units",
    "shared",
    "scaffold"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "summary"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "summary": {
          "type": "string"
        },
        "goModulePath": {
          "type": "string",
          "description": "The Go module path (e.g. github.com/acme/shop)"
        },
        "phpNamespace": {
          "type": "string",
          "description": "The PHP root namespace (e.g. Acme\\Shop)"
        }
      }
    },
    "scaleClass": {
      "enum": [
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "topology": {
      "enum": [
        "monolith",
        "modular-monolith",
        "microservices"
      ]
    },
    "repoLayout": {
      "enum": [
        "single",
        "monorepo"
      ]
    },
    "adr": {
      "type": "string",
      "description": "Path of the confirmed ADR"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "description": "Deployment units (processes started and deployed independently). Usually one in a monolith, one per service in microservices. Several deployment units sharing one build unit (go.mod / composer.json / Cargo workspace), such as an API and a worker, are listed as units with the same path and told apart by entrypoint",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "language",
          "pattern",
          "path",
          "responsibilities"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "app",
              "service",
              "worker",
              "gateway",
              "bff"
            ]
          },
          "language": {
            "enum": [
              "go",
              "php",
              "rust"
            ]
          },
          "pattern": {
            "enum": [
              "layered",
              "clean",
              "hexagonal",
              "ddd-clean",
              "ddd-hexagonal",
              "vertical-slice"
            ]
          },
          "packaging": {
            "enum": [
              "by-layer",
              "by-feature",
              "hybrid"
            ],
            "description": "How packages are split. by-layer = layers at the top level, split by feature inside; by-feature = features (modules) at the top level, split by layer inside; hybrid = split by feature, with only shared cross-cutting concerns placed by layer. The criteria are in patterns.md of architecture-patterns"
          },
          "cqrs": {
            "type": "boolean",
            "default": false
          },
          "framework": {
            "type": "string",
            "description": "The main framework. e.g. net/http, chi, echo, gin, laravel, symfony, slim, axum, actix-web"
          },
          "libraries": {
            "type": "object",
            "description": "Major libraries per role (chosen with skills/architecture-patterns/references/frameworks.md). Example keys: http, rpc, db, migration, messaging, test",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "path": {
            "type": "string",
            "description": "Path relative to the repository root. '.' for a single-unit layout"
          },
          "entrypoint": {
            "type": "string",
            "description": "This unit's entrypoint (relative to path). e.g. cmd/api for Go, bin/worker or public/index.php for PHP, crates/api for Rust. Required for units sharing the same path, and must differ between them"
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dataStore": {
            "type": "string",
            "description": "e.g. postgres, mysql, redis, none"
          },
          "exposes": {
            "type": "array",
            "items": {
              "enum": [
                "rest",
                "grpc",
                "graphql",
                "events",
                "cli",
                "none"
              ]
            }
          },
          "consumes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Events subscribed to / other units called"
          },
          "modules": {
            "type": "array",
            "description": "Modules in a modular monolith (bounded contexts)",
            "items": {
              "type": "object",
              "required": [
                "name",
                "pattern"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "pattern": {
                  "enum": [
                    "layered",
                    "clean",
                    "hexagonal",
                    "ddd-clean",
                    "ddd-hexagonal",
                    "vertical-slice"
                  ]
                },
                "publicApi": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "cqrs": {
                  "type": "boolean",
                  "default": false,
                  "description": "Use CQRS (separate command and query models) only in this module"
                }
              }
            }
          },
          "sampleFeature": {
            "type": "object",
            "description": "A sample implementation that goes through every layer",
            "properties": {
              "aggregate": {
                "type": "string",
                "description": "e.g. Order"
              },
              "useCases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "e.g. [\"CreateOrder\", \"GetOrder\"]"
              }
            }
          },
          "platform": {
            "type": "object",
            "description": "A shared cross-cutting package (one even across units sharing the same path). No domain code",
            "required": [
              "path",
              "allow"
            ],
            "properties": {
              "path": {
                "type": "string",
                "description": "Path relative to path. e.g. internal/platform"
              },
              "allow": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Allowlist of what may go there. e.g. [\"db-pool\", \"logger\", \"http-server\", \"middleware\", \"otel\"]"
              }
            }
          }
        }
      }
    },
    "shared": {
      "type": "object",
      "properties": {
        "contracts": {
          "enum": [
            "openapi",
            "proto",
            "both",
            "none"
          ]
        },
        "messaging": {
          "type": "string",
          "description": "e.g. none, nats, kafka, rabbitmq, sqs, pubsub"
        },
        "observability": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "e.g. [\"structured-logging\", \"opentelemetry\"]"
        },
        "auth": {
          "type": "string"
        }
      }
    },
    "conventions": {
      "type": "array",
      "description": "Implementation conventions decided in the ADR (those the other schema fields cannot express). Referred to by the scaffolders and the conformance check",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C[0-9]+$",
            "description": "e.g. C1"
          },
          "rule": {
            "type": "string",
            "description": "The convention text (one sentence)"
          },
          "check": {
            "enum": [
              "arch-lint",
              "grep",
              "test",
              "review"
            ],
            "description": "How it is checked mechanically. review means a human or the critic reads it"
          }
        }
      }
    },
    "scaffold": {
      "type": "object",
      "properties": {
        "docker": {
          "type": "boolean",
          "default": true
        },
        "ci": {
          "enum": [
            "github-actions",
            "none"
          ],
          "default": "github-actions"
        },
        "archLint": {
          "type": "boolean",
          "default": true,
          "description": "Generate settings that check the dependency-direction rules mechanically"
        },
        "claudeSettings": {
          "type": "boolean",
          "default": false,
          "description": "Generate the Claude Code project settings .claude/settings.json (a permission allowlist for build, test and lint commands, and a read ban on .env)"
        },
        "codegen": {
          "type": "boolean",
          "default": true,
          "description": "Run code generators such as sqlc / oapi-codegen / buf and wire in the generated code"
        }
      }
    }
  }
}
